# ============================================================
# AI 引擎配置（复制本文件为 .env 后修改；.env 已被 gitignore）
# 任选一个 OpenAI 兼容平台即可，只改下面 3 行，代码无需改动。
# 不配置 key 也能跑：AI 功能自动降级为本地规则引擎（检索式答疑/抽取式总结）。
# ============================================================

AI_API_KEY=
AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AI_MODEL=glm-4-flash

# ============================================================
# 免费额度方案速查（2026-10 核对，以各平台官网为准）
# ============================================================
#
# 【方案 A · 强烈推荐】智谱 GLM —— 永久免费，国内直连，中文强
#   注册：https://open.bigmodel.cn  →  API Keys
#   GLM-4-Flash 完全免费（128K 上下文，30 并发），新用户另送 2000 万 Token
#   AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#   AI_MODEL=glm-4-flash
#
# 【方案 B】硅基流动 SiliconFlow —— 9B 以下模型永久免费，100+ 模型可选
#   注册：https://siliconflow.cn  →  API 密钥
#   AI_BASE_URL=https://api.siliconflow.cn/v1
#   AI_MODEL=Qwen/Qwen2.5-7B-Instruct
#
# 【方案 C】阿里云百炼（通义千问）—— 新用户 100 万+ Token 额度，有效期约 90 天
#   注册：https://bailian.console.aliyun.com  →  API-KEY
#   AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   AI_MODEL=qwen-turbo
#
# 【方案 D】OpenRouter —— 聚合站，有 :free 后缀的免费模型（50 次/天）
#   AI_BASE_URL=https://openrouter.ai/api/v1
#   AI_MODEL=deepseek/deepseek-chat:free
#
# 【方案 E · 付费】DeepSeek 官方 —— 便宜且推理强，注册送 500 万 Token
#   AI_BASE_URL=https://api.deepseek.com
#   AI_MODEL=deepseek-chat
#
# 配置完成后，启动后端访问 POST /api/ai/test 可自检连通性
# （返回 401/402/404 等会给出具体原因，不必猜）。
