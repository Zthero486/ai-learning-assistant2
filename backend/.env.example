# ============================================================
# 历史学习助手 · AI 配置模板
# 复制为 .env 后填写；也可直接在软件界面「AI 助手 → 配置 API Key」里填，效果相同
# ============================================================

# ---- 方案 A：阶跃星辰 StepFun（当前使用：国内直连，实测出 5 题约 20s）----
AI_API_KEY=在这里粘贴你的 StepFun Key
AI_BASE_URL=https://api.stepfun.com/v1
AI_MODEL=step-3.5-flash
# 国内接口走直连，代理留空
AI_PROXY=
# 说明：若账号有生效中的 Step Plan 订阅，可把地址换成
#   https://api.stepfun.com/step_plan/v1（专属频道，不扣按量余额）；
# 没订阅时用该地址会报 400 "you have no active step plan subscription"。

# ---- 方案 B：智谱 GLM（国内直连，永久免费，无需代理）----
# AI_API_KEY=在这里粘贴你的智谱 Key
# AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# AI_MODEL=glm-4-flash
# AI_PROXY=

# ---- 方案 C：Google Gemini（需代理，2026-11 起免费档对新项目多已停用）----
# AI_API_KEY=你的 Gemini Key
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-3-flash-preview
# AI_PROXY=http://127.0.0.1:7897

# ---- 方案 D：MiniMax M Plan（订阅制）----
# Key 取「订阅管理 → M Plan」里的订阅 Key（不是按量付费 Key）
# AI_API_KEY=订阅Key
# AI_BASE_URL=https://api.minimax.cn/v1
# AI_MODEL=MiniMax-M3.1-Flash
# AI_PROXY=

# ---- 方案 E：DeepSeek（国内直连，付费）----
# AI_BASE_URL=https://api.deepseek.com
# AI_MODEL=deepseek-chat
